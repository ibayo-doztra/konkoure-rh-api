# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
# Frontend web, pour les liens des e-mails (vérification, réinitialisation)
WEB_APP_URL=http://localhost:8080
DEFAULT_LOCALE=fr

# Base de données (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=konkoure
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=10000
# Applique la RLS en local quand DB_USER est superutilisateur (production : DB_USER=konkoure_app)
# DB_APP_ROLE=konkoure_app

# Redis (docker compose up -d redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_CACHE=0
REDIS_DB_QUEUE=1
REDIS_DB_LIMITER=2
LIMITER_STORE=redis
# Budget global par IP et par minute (défaut 300). Réservé aux tests et à l'e2e : refusé en production.
# RATE_LIMIT_GLOBAL_IP_PER_MINUTE=

# Files : sync en développement ; bullmq exige `node ace queue:work`
QUEUE_DRIVER=sync

# Stockage : fs en local, s3 en production
DRIVE_DISK=fs
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_PUBLIC_BASE_URL=

# Authentification (valeurs par défaut de docs/backend/11 §1)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_TTL_MOBILE=90d
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m
# Domaine du cookie de refresh en production (ex. .konkoure.doztra.cloud)
REFRESH_COOKIE_DOMAIN=

# Sécurité : origines autorisées, séparées par des virgules
CORS_ORIGINS=http://localhost:8080

# E-mail (Resend). Sans clé, les e-mails ne partent pas.
MAIL_MAILER=resend
MAIL_FROM_NAME=Konkouré
MAIL_FROM_ADDRESS=support@konkoure.doztra.cloud
RESEND_API_KEY=
