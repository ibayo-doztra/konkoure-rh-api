# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
# Frontend web, pour les liens des e-mails (vérification, réinitialisation)
WEB_APP_URL=http://localhost:8080
DEFAULT_LOCALE=fr

# Base de données (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=konkoure
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=10000

# Redis (docker compose up -d redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_CACHE=0
REDIS_DB_LIMITER=2
LIMITER_STORE=redis

# Authentification (valeurs par défaut de docs/backend/11 §1)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_TTL_MOBILE=90d
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m
# Domaine du cookie de refresh en production (ex. .konkoure.doztra.cloud)
REFRESH_COOKIE_DOMAIN=

# Sécurité : origines autorisées, séparées par des virgules
CORS_ORIGINS=http://localhost:8080

# E-mail (Resend). Sans clé, les e-mails ne partent pas.
MAIL_MAILER=resend
MAIL_FROM_NAME=Konkouré
MAIL_FROM_ADDRESS=support@konkoure.doztra.cloud
RESEND_API_KEY=
